# Chaos Oracle Agent — Environment Variables
# Copy this file to .env and fill in real values.
# In production, critical secrets are loaded from GCP Secret Manager and overlay these values.

# --- GitHub ---
GITHUB_PAT=your_github_pat_here

# --- Agent Identity ---
IDENTITY=Chaos Oracle
EMAIL=your_agent_email_here

# --- Discord ---
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_APPLICATION_ID=your_discord_application_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here

# --- Farcaster (Neynar) ---
NEYNAR_API_KEY=your_neynar_api_key_here
NEYNAR_SIGNER_UUID=your_neynar_signer_uuid_here
NEYNAR_CLIENT_ID=your_neynar_client_id_here
FARCASTER_HANDLE=@your_farcaster_handle

# --- Twitter / X ---
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here
TWITTER_ACCESS_TOKEN=your_twitter_access_token_here
TWITTER_ACCESS_SECRET=your_twitter_access_secret_here
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here
TWITTER_CLIENT_ID=your_twitter_client_id_here
TWITTER_USER_ID=your_twitter_user_id_here

# --- Blockchain / Wallet ---
AGENT_PRIVATE_KEY=0x_your_agent_private_key_here
AGENT_PUBLIC_ADDRESS=0x_your_agent_public_address_here
CONTRACT_ADDRESS=0x_your_contract_address_here

# --- DNS ---
DUCKDNS_TOKEN=your_duckdns_token_here
DUCKDNS_DOMAIN=your_duckdns_domain_here

# --- Email ---
AGENT_EMAIL_APP_PASSWORD=your_email_app_password_here

# --- AI / LLM ---
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# --- Dev Tools ---
OPENHANDS_API_URL=http://localhost:3000

# --- Reddit ---
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_REFRESH_TOKEN=your_reddit_refresh_token_here
REDDIT_USERNAME=your_reddit_username_here

# --- GCP Secret Manager Managed (optional in .env, loaded from GCP in production) ---
# REPLICATE_API_TOKEN=your_replicate_api_token_here
# PINATA_JWT=your_pinata_jwt_here
# BASESCAN_API_KEY=your_basescan_api_key_here
# CHAOS_CARDS_CONTRACT=0x_your_chaos_cards_contract_here
# MOLTBOOK_API_KEY=your_moltbook_api_key_here
