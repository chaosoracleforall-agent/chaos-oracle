    "social:history:tail": "TS_NODE_COMPILER_OPTIONS='{\"moduleResolution\":\"NodeNext\"}' node -r ts-node/register/transpile-only socialHistoryTail.ts",
    "growth:test-live": "TS_NODE_COMPILER_OPTIONS='{\"moduleResolution\":\"NodeNext\"}' node -r ts-node/register/transpile-only growthLiveTest.ts"
  },
  "dependencies": {
