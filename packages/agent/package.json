    "@types/nodemailer": "^7.0.11",
    "alchemy-sdk": "3.6.5",
    "axios": "1.13.6",
    "discord.js": "^14.25.1",
    "dotenv": "17.3.1",
    "ethers": "6.16.0",
    "form-data": "^4.0.1",
    "imap": "0.8.19",
    "mailparser": "3.9.3",
    "nodemailer": "^8.0.1",
    "snoowrap": "^1.23.0",
    "ts-node": "10.9.2",
    "twitter-api-v2": "1.29.0",
    "typescript": "^5.9.3",
    "viem": "2.47.0"
