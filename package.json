{
  "name": "chaos-oracle-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/frontend",
    "packages/agent",
    "packages/contracts"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=packages/frontend",
    "build": "npm run build --workspace=packages/frontend",
    "deploy:frontend": "cd packages/frontend && npx next build && npx firebase deploy",
    "test:contracts": "cd packages/contracts && npx hardhat test",
    "agent:start": "cd packages/agent && npx ts-node index.ts",
    "agent:pm2": "pm2 start ecosystem.config.js"
  }
}
